msgstr "The Relying Party requests %(requested)s and the wallet holds %(held)s."

msgid "Il Relying Party chiede %(requested)s e il wallet non possiede attestazioni."
msgstr "The Relying Party requests %(requested)s and the wallet holds no attestations."

msgid "I dati da condividere con l'issuer non sono nel formato atteso."
msgstr "The details to share with the issuer are not in the expected format."

msgid "I dati da presentare al verificatore non sono nel formato atteso."
msgstr "The details to present to the verifier are not in the expected format."

msgid "Manca l'elenco dei dati da presentare al verificatore."
msgstr "The list of details to present to the verifier is missing."

msgid "Il verificatore indicato nel QR non è un URL valido."
msgstr "The verifier in the QR code is not a valid URL."

msgid "Il contenuto del QR non è un URL valido."
msgstr "The QR code content is not a valid URL."

