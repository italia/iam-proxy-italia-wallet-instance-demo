msgstr "Enter an http or https URL."

msgid "Impossibile leggere i metadata di questo issuer."
msgstr "The wallet cannot read this issuer's metadata."

msgid "Questo indirizzo non pubblica attestazioni ottenibili."
msgstr "This address does not publish attestations you can obtain."

msgid "Richiesta in corso..."
msgstr "Request in progress..."

msgid "Ti sto portando all'issuer per scegliere l'identità digitale. Al termine torni qui e l'attestazione viene salvata."
msgstr "Taking you to the issuer to choose a digital identity. When that finishes, you return here and the attestation is saved."

msgid "Per il rilascio di {name}, non sarà condiviso alcun dato con l'issuer."
msgstr "No details will be shared with the issuer to issue {name}."

msgid "Per il rilascio di {name}, saranno condivisi con l'issuer i seguenti dati:"
msgstr "These details will be shared with the issuer to issue {name}:"

msgid "Premendo Continua autorizzi la trasmissione delle informazioni."
msgstr "Continue authorizes sending this information."

msgid "Continua"
msgstr "Continue"

msgid "La risposta non contiene l'elenco dei dati da condividere."
msgstr "The response does not list the details to be shared."

msgid "Non riesco a ottenere l'attestazione."
msgstr "The wallet cannot obtain the attestation."

msgid "Errore sconosciuto"
msgstr "Unknown error"

msgid "Attestazione ottenuta."
msgstr "Attestation saved."

msgid "Visualizzala"
msgstr "View it"

msgid "Non riesco a salvare l'attestazione."
msgstr "The wallet cannot save the attestation."

msgid "Per l'accesso con il verificatore selezionato, non sarà condiviso alcun dato."
msgstr "No details will be shared to sign in with the selected verifier."

msgid "Per l'accesso con il verificatore selezionato, saranno condivisi i seguenti dati:"
msgstr "These details will be shared to sign in with the selected verifier:"

msgid "Impossibile effettuare l'accesso"
msgstr "The wallet cannot complete the sign-in."

msgid "Rimuovere l'attestazione {name}?"
msgstr "Remove attestation {name}?"

